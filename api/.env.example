# Server-only configuration. Blank cloud values permit local liveness checks.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_PUBLIC_KEY=
# Server ONLY; never copy into mobile configuration.
SUPABASE_SERVICE_ROLE_KEY=
AI_ENABLED=false
# Set only after the operator verifies Free plan and accepts provider data policy.
AI_FREE_PLAN_CONFIRMED=false
AI_DATA_POLICY_CONFIRMED=false
# Set only after documented bilingual/policy evaluation; gates automatic publication.
AI_LANGUAGE_REVIEW_PASSED=false
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Documentation-checked example; actual account access is NOT yet verified.
AI_TRANSLATION_MODEL=qwen/qwen3.8-27b
AI_SUMMARY_MODEL=qwen/qwen3.8-27b
AI_MODERATION_MODEL=qwen/qwen3.8-27b
AI_FREE_TIER_ONLY=true
AI_ALLOW_PAID_FALLBACK=false
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_REQUESTS_PER_DAY=100
AI_MAX_TOKENS_PER_MINUTE=4000
AI_MAX_TOKENS_PER_DAY=50000
AI_MAX_CONCURRENT_REQUESTS=1
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=512
AI_REQUEST_TIMEOUT_SECONDS=20
ALLOWED_ORIGINS=[]
DEMO_MODE=false
