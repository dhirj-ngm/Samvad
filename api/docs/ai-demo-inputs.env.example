# Private launcher inputs. Copy to api/.env.ai-demo-inputs (ignored).
# start_ai_demo validates supported Settings and preserves the original api/.env.
SARVAM_API_KEY=
SARVAM_ACCOUNT_USE_AUTHORIZED=false
# Maximum permitted remaining credits in INR, including rehearsal/cache prewarming.
SARVAM_MAX_CREDIT_INR=0
# Additional optional maximum character budget; zero means no calls until agreed.
SARVAM_MAX_CHARACTERS=0
# Text setup details (no credentials). Suggested values: local or hosted.
DEMO_ENVIRONMENT=
DEMO_DATE=
DEMO_DURATION_MINUTES=
DEMO_DEVICES=
DEMO_NETWORK=
