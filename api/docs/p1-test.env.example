# Copy to api/.env.p1 (ignored). Dedicated, email-confirmed DEVELOPMENT accounts only.
# This harness replaces their profiles/interest selections and retains test data.
SAMVAD_P1_TEST_URL=
SAMVAD_P1_PUBLIC_KEY=
SAMVAD_P1_EMAIL_A=
SAMVAD_P1_PASSWORD_A=
SAMVAD_P1_EMAIL_B=
SAMVAD_P1_PASSWORD_B=
# Explicit opt-in; change only after selecting the agreed development project.
SAMVAD_P1_ALLOW_WRITES=false
