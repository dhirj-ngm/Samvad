{
  "expo": {
    "name": "Samvad",
    "slug": "samvad",
    "scheme": "samvad",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Samvad uses your selected photo for your optional public profile avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
